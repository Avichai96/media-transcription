# Settings for running the app locally, which uv reads together with local.secret.env:
#   uv run --env-file environment/local/local.config.env --env-file environment/local/local.secret.env fastapi dev
# compose.yaml loads both files too, and points the app at its own services instead.
APP_ENV=local
DEBUG=true

TRANSCRIPTION_MODEL_ID=Systran/faster-whisper-small
TRANSCRIPTION_DEVICE=cpu
TRANSCRIPTION_COMPUTE_TYPE=int8
TRANSCRIPTION_CPU_THREADS=4
TRANSCRIPTION_MAX_AUDIO_SECONDS=120
TRANSCRIPTION_MAX_UPLOAD_MIB=25
TRANSCRIPTION_RETRY_AFTER_SECONDS=10
